# Template for infra/production/egress-proxy.env, which is NOT in git. Read
# by the egress proxy ALONE (S2, 2026-09-24; infra/production/README.md,
# Egress).
#
#   cp infra/production/egress-proxy.env.example infra/production/egress-proxy.env
#   chown root:root infra/production/egress-proxy.env
#   chmod 600      infra/production/egress-proxy.env
#
# The keys come from `python scripts/egress_setup.py keygen`, which prints
# each one once. The proxy refuses to start while a key is missing or
# malformed, and it also refuses to start if this file carries any of the
# platform's own secrets (NOCTORNAL_TOTP_KEK, DATABASE_URL, the MinIO or
# sample store keys, the ingest pepper): it talks to the internet and needs
# none of them. Never copy secrets.env into this file.

# The proxy's own database login: role noctornal_egress, with the password
# postgres-init.env gives it (the two must agree; preflight checks). It can
# read the routes and append to the connection ledger and nothing more.
NOCTORNAL_EGRESS_DATABASE_URL=postgresql://noctornal_egress:replace-me@postgres:5432/noctornal

# The route tokens are keyed by this; api and cron hold the same value in
# egress-client.env. Rotating it means changing both files and restarting
# api, cron and the proxy; it changes no stored fingerprint.
NOCTORNAL_EGRESS_CLIENT_KEY=replace-me

# The X25519 private key sealed exits are opened with. KEY LOSS: losing this
# key loses every sealed exit, which must then be sealed again under a new
# key. To rotate, put the old key in NOCTORNAL_EGRESS_SEAL_KEY_RETIRED
# (comma separated), the new one here and its public half in
# egress-client.env, run `python -m noctornal_api.egress_proxy rewrap --apply`
# in this container, and only then drop the retired key.
NOCTORNAL_EGRESS_SEAL_KEY=replace-me
NOCTORNAL_EGRESS_SEAL_KEY_RETIRED=

# The key exit fingerprints are made with; egress-client.env holds the same
# value. It is never rotated. Losing or changing it stops every chained exit
# until each is sealed again, and each reseal counts as a widening that
# voids the collection authorities recorded before it.
NOCTORNAL_EGRESS_FINGERPRINT_KEY=replace-me

# Optional: the networks a local exit sidecar (Tor, a VPN client) may sit
# in, comma separated, each inside the exits network 172.31.245.0/24.
# NOCTORNAL_EGRESS_UPSTREAM_ALLOW=172.31.245.0/28
