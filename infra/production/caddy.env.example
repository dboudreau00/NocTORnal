# Template for infra/production/caddy.env, which is NOT in git. Read by the
# caddy service ALONE (infra-5, 2026-10-03; infra/production/README.md, step 1).
#
#   cp infra/production/caddy.env.example infra/production/caddy.env
#   chown root:root infra/production/caddy.env
#   chmod 600      infra/production/caddy.env
#
# These three values are all the TLS terminator needs, and they are all it
# gets. It is the one process the internet reaches before any sign-in, and
# until 2026-10-03 it was handed the whole of secrets.env (the key that seals
# every second factor, both database DSNs, the MinIO root credential, the
# Redis password). Nothing in this file is a secret; it is its own file so that
# nothing that is can reach Caddy. Never copy secrets.env into it.
#
# An upgrade from a tree where these three lived in secrets.env: copy the three
# lines over (the old ones in secrets.env are harmless and can go), or compose
# refuses the whole file with "env file ... caddy.env not found" before it
# touches a running container.

# The two names Caddy terminates TLS for. They must be genuinely different
# hosts. The runtime cannot tell a real origin split from a CNAME onto the
# same host (docs/16 C9), so nothing here will catch it if they are not.
NOCTORNAL_HOSTNAME=noctornal.example.org
NOCTORNAL_SAMPLE_HOSTNAME=samples.example.org

# `internal` for a local verification run with Caddy's own CA, or an e-mail
# address to switch Caddy to ACME with that account. See
# infra/production/Caddyfile.
NOCTORNAL_TLS_MODE=internal
