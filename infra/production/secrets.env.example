# Template for infra/production/secrets.env, which is NOT in git.
#
#   cp infra/production/secrets.env.example infra/production/secrets.env
#   chown root:root infra/production/secrets.env
#   chmod 600      infra/production/secrets.env
#
# Every value below is a PLACEHOLDER. Replace all of them. The API refuses
# to start while any secret, or either legal declaration, still carries a
# `replace-me` placeholder. A user name or access key is not a secret (it
# names the account a password belongs to), so one left as its placeholder
# is not refused: replace those too. The other values fail silently rather
# than loudly if you leave them, and each line says which.
#
# Two warnings before you edit anything:
#
#   1. `docker compose config` PRINTS the contents of this file, resolved
#      into each service's environment. Do not paste that output into a
#      ticket, a chat or a bug report.
#
#   2. Passwords are embedded in URLs below. Generate them from a URL-safe
#      alphabet or percent-encode them by hand -- an unencoded `@`, `:`,
#      `/` or `#` in a DSN silently truncates the URL into a different,
#      valid-looking one:
#
#          python -c "import secrets; print(secrets.token_urlsafe(32))"
#
#      `token_urlsafe` emits only letters, digits, `-` and `_`, all of
#      which are safe unencoded.
#
# Nothing egress-related goes in this file (2026-09-24). Every
# application service receives it, and the egress proxy must hold none of
# it. Caddy does not either (infra-5, 2026-10-03): its three values are in
# caddy.env. The egress keys are in egress-proxy.env and egress-client.env,
# and the egress role's password in postgres-init.env: copy each from its
# .example beside this one (infra/production/README.md, Egress).
#
# Nor does the schema OWNER's credential (docs/17 F52, 2026-10-02). Its
# password is POSTGRES_PASSWORD in postgres-init.env, which the database
# alone reads, and its DSN is NOCTORNAL_MIGRATION_DATABASE_URL in
# migrate.env, which the migration job alone reads. compose.yml hands
# every other service both as empty values whatever this file says, and
# the API and the cron jobs refuse to run holding either. An older
# secrets.env that still carries them is moved for you, with a backup, by
#
#   sudo ./release/install.sh --production-secrets
#
# (release/install.ps1 -ProductionSecrets on Windows), which also writes
# the Redis password and REDIS_URL below (release/secrets-upgrade/README.md).
#
# One restriction on the MinIO root pair below (infra-10, 2026-10-03): neither
# MINIO_ROOT_USER nor MINIO_ROOT_PASSWORD may contain a colon. minio-init gives
# mc the pair as a URL, where a colon ends the access key; it refuses a pair
# with one rather than sending a different credential.


# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
# There are TWO roles on purpose. `noctornal` owns the schema and is the
# only thing that runs Alembic. `noctornal_app` is least privilege, is not
# the owner, and cannot ALTER TABLE ... DISABLE TRIGGER -- which is exactly
# what a compromised API process would want in order to write around the
# audit and custody chains. The owner's password and DSN are NOT in this
# file: see the header (docs/17 F52).

# The APP role's password. Read by the initdb script that creates the role.
# initdb scripts run ONCE, against an empty data directory: changing this
# later does nothing to an existing cluster, and you have to ALTER ROLE by
# hand. It must match the password inside DATABASE_URL below.
NOCTORNAL_APP_DB_PASSWORD=replace-me-app-password

# What the API, the sample origin and the cron loop connect as. It must name
# noctornal_app, never the owner and never a superuser: production refuses to
# start on either (the refusal names this variable and never the role), because
# the owner is not bound by row-level security and may disable the append-only
# triggers on the audit and custody chains. If the volume was initialised
# without NOCTORNAL_APP_DB_PASSWORD that role does not exist yet; step 2 of
# infra/production/README.md says what to do.
DATABASE_URL=postgresql+psycopg://noctornal_app:replace-me-app-password@postgres:5432/noctornal

# S1 (2026-09-25): the SYSTEM role, noctornal_worker, which bypasses
# row-level security for the work that must see every row (retention,
# legal holds, lock extension, merges, the withheld counts, sign-in and
# every script). Its password is NOCTORNAL_WORKER_DB_PASSWORD in
# postgres-init.env, which only the database reads; repeat it here. The
# sample origin is started with this blanked (compose.yml), and the API
# refuses to start on a process that is not the sample origin without it.
NOCTORNAL_WORKER_DATABASE_URL=postgresql+psycopg://noctornal_worker:replace-me-worker-password@postgres:5432/noctornal


# ---------------------------------------------------------------------------
# Redis -- the rate limiter's meter store
# ---------------------------------------------------------------------------

# The password of noctornal_limiter, the limiter's OWN Redis user (the
# limiter's Redis ACL, 2026-10-02). The redis service builds its ACL file
# from it at every start: the default user is disabled, and
# noctornal_limiter may read and write keys under rl: alone and run only
# the commands the limiter sends (ratelimit_redis.LIMITER_ACL_COMMANDS,
# which says what three of them can still see). Nothing is stored with
# it, so changing it costs a restart and nothing else. URL-safe characters
# only: REDIS_URL repeats it, and the redis service compares the two as
# text. The installer generates it:
#
#   sudo ./release/install.sh --production-secrets
REDIS_PASSWORD=replace-me-redis-password

# Signs in as noctornal_limiter with REDIS_PASSWORD, written out again:
# `redis://noctornal_limiter:PASSWORD@redis:6379/0`. While it names the
# bundled service (host `redis`), the redis service refuses to start when
# it does not begin with exactly that user and that password, because a
# URL with no user name signs in as `default`, which is disabled here, and
# every limit that fails closed would refuse everyone. A Redis of your own
# on another host is yours to secure (infra/production/README.md, The
# limiter's Redis). Unset, the limiter falls back to per-process meters and
# four uvicorn workers then enforce four times the configured rate. The
# readiness register fails on an unset REDIS_URL for that reason.
REDIS_URL=redis://noctornal_limiter:replace-me-redis-password@redis:6379/0


# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------

# MinIO's root credentials, read by MinIO and minio-init. The API reads the
# same pair as MINIO_ACCESS_KEY and MINIO_SECRET_KEY below, for the evidence
# and raw buckets. MINIO_ROOT_USER must be at least 3 characters and
# MINIO_ROOT_PASSWORD at least 8, or MinIO refuses to start.
MINIO_ROOT_USER=replace-me-minio-root-user
MINIO_ROOT_PASSWORD=replace-me-minio-root-password

# host:port with NO scheme -- the minio client library builds the URL from
# MINIO_SECURE. Putting `http://` here produces a connection error that
# names DNS rather than the setting.
#
# The host part must be `minio`, because that is the name in the
# certificate's subjectAltName (infra/production/README.md, step 3) and the
# name every client verifies the handshake against.
MINIO_ENDPOINT=minio:9000

# The API's own credentials for evidence and raw captures. Same values as
# the root pair above: MinIO is reached only over the compose network and
# no port is published. Splitting these into a second service account is
# worthwhile and has not been done.
MINIO_ACCESS_KEY=replace-me-minio-root-user
MINIO_SECRET_KEY=replace-me-minio-root-password

# NOT optional, and not a formality. `config.enforce_environment()` refuses
# to start the API unless this is exactly "true" (no leading space -- the
# refusal deliberately matches the clients' own strict test). MinIO is given
# a certificate for that reason; see step 3 of the README. Set to false and
# the API will not boot; set to true with no certificate in ./tls and every
# evidence call fails its handshake.
MINIO_SECURE=true

# The WORM bucket. Created --with-lock by the minio-init service, and
# object lock CANNOT be enabled afterwards. Renaming this variable after
# first boot points the API at a bucket that has no lock, and the readiness
# register is what catches that.
EVIDENCE_BUCKET=noctornal-evidence

# Raw captures. No lock, no retention rule.
INGEST_BUCKET=noctornal-raw

# Collected raw markup: each forum item's own fragment, kept so a parser
# that turns out to be wrong can re-parse what was read. NO object lock:
# it is unvetted bytes holding other people's personal data, a retention
# clock or a deletion order must be able to remove it, and the purge
# deletes it with its document. Created by minio-init without a lock.
COLLECT_RAW_BUCKET=noctornal-collect-raw

# ---- Collection ceilings (every forum and Telegram source) ------------------
#
# The highest label a forum or a Telegram source may carry and still be
# read by the collector. Unset means that collection is OFF. It takes CLEAR,
# GREEN or AMBER only: AMBER_STRICT and RED never leave this platform
# (invariant 8), and production refuses to start with either. What leaves
# the host when a source is read is the fact that an exit reads it, with
# every request; the pages come back in, and nothing collected is sent
# out. Work above the ceiling, or needing a compartment, is collected by
# hand into its case.
# NOCTORNAL_FORUM_SOURCE_CEILING=AMBER
# NOCTORNAL_TELEGRAM_SOURCE_CEILING=AMBER

# ---- The sample store, on its own credentials -----------------------------
# SAMPLE_* override MINIO_* for the samples bucket alone (samples.py falls
# back to the MINIO_* pair when these are unset). SAMPLE_ACCESS_KEY and
# SAMPLE_SECRET_KEY are NOT credentials you fetch from MinIO: they are the
# credentials the minio-init service MINTS, as a service account whose
# inline policy reaches the samples bucket and nothing else. Choose them
# here and they will exist after the first `up`.

# The same MinIO, and deliberately so: one object store serving two buckets
# is a legitimate production shape, so config.py has no rule about the host
# at all. Its two rules are about the credentials, and they are rules about
# them being SET: an unset SAMPLE_ACCESS_KEY or SAMPLE_SECRET_KEY is
# refused, because SampleStorage falls back per variable to the MINIO_*
# twin and opens the malware bucket with the evidence bucket's credential
# without saying so. Nothing compares the two pairs, though, so typing the
# evidence credentials in here passes the check and produces exactly the
# shared blast radius it was written to prevent. Choose different ones.
SAMPLE_ENDPOINT=minio:9000

# MinIO takes a service account's access key at 3 to 20 characters and its
# secret key at 8 to 40; minio-init refuses any other length by name, and
# the API waits for minio-init. The header's token_urlsafe(32) is 43, too
# long here. The same holds for the PRESERVE_ pair below:
#
#   python3 -c "import secrets; print(secrets.token_hex(8))"        access key
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"   secret key
SAMPLE_ACCESS_KEY=replace-me-sample-access-key
SAMPLE_SECRET_KEY=replace-me-sample-secret-key

# Same rule as MINIO_SECURE above, and the API refuses to boot on this one
# separately: live malware bytes in clear text is the case docs/11 makes.
SAMPLE_SECURE=true

# NEVER give this bucket object lock or a retention default. docs/11's
# rejection path has to be able to destroy sample bytes, and a lock would
# make that impossible for the whole retention period.
SAMPLE_BUCKET=noctornal-samples

# ---- Rejected samples: preserved, on their own credentials (F2) -------------
# A rejected sample is PRESERVED by default, not destroyed: its ciphertext
# moves into PRESERVE_BUCKET under a per-object legal hold and its data key
# is kept, and a retrieval needs a Security Officer's authorisation naming
# the person (docs/11). minio-init creates the bucket WITH object lock and
# no default retention, and, when the two keys below are set, mints them as
# a service account that can write, read and set a hold there and cannot
# delete or lift one. Leave them unset and the SAMPLE_* account is used,
# which cannot reach this bucket, so every rejection that disposes of the
# bytes is refused rather than destroying anything. Choose different ones.
PRESERVE_BUCKET=noctornal-preserved
PRESERVE_ACCESS_KEY=replace-me-preserve-access-key
PRESERVE_SECRET_KEY=replace-me-preserve-secret-key
# The store's address and TLS fall back to SAMPLE_ENDPOINT and SAMPLE_SECURE,
# which is right on this compose file: leave both unset. PRESERVE_SECURE set
# to anything but "true" is refused at boot.
# PRESERVE_ENDPOINT=
# PRESERVE_SECURE=

# `preserve` (the owner's default) or `destroy`. Anything else refuses every
# rejection that disposes of the bytes until it is corrected. Choose
# `destroy` only on counsel's instruction: some prohibited material must not
# be kept at all, and a legal hold on the sample or its case still refuses
# a destruction.
NOCTORNAL_REJECTED_SAMPLE_DISPOSITION=preserve


# ---------------------------------------------------------------------------
# Application secrets
# ---------------------------------------------------------------------------

# Base64, decoding to EXACTLY 32 bytes -- AES-256-GCM. It seals every TOTP
# secret at rest. Generate it with the method release/install.sh uses:
#
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
#
# LOSING THIS MEANS EVERY USER MUST RE-ENROL THEIR AUTHENTICATOR. Back it
# up somewhere the compose host is not. ROTATING it is a runbook, below,
# and does not have that effect as long as the old key is retired rather
# than discarded.
#
# There is no default anywhere in the code. Under NOCTORNAL_ENV=production
# -- which the compose file sets on every application service --
# `config.verify_environment()` runs the envelope's OWN reader at boot, so
# an unset or wrong-length key stops the API here, named, with the other
# refusals. Without that variable it is not caught until a second factor is
# sealed or opened: a different program, long after it was typed. The
# placeholder below is that case, so a first `up` refuses on this line
# until you replace it.
NOCTORNAL_TOTP_KEK=replace-me-base64-32-bytes

# The key ring, for rotation. Leave both unset until you rotate.
#
# Every sealed blob records the id of the key that sealed it, and the
# envelope opens a blob with the key that id names. To rotate:
#   1. generate a new key, set it as NOCTORNAL_TOTP_KEK, give it a NEW id
#      here, and move the OLD key into NOCTORNAL_TOTP_KEK_RETIRED under
#      the OLD id;
#   2. restart -- everything still opens, new blobs seal under the new key,
#      and readiness `kek_ring_opens_stored_secrets` lists both ids;
#   3. `python scripts/rewrap_secrets.py --apply` inside the api container;
#   4. when that check reports only the active id, drop the retired entry.
# A new key under the SAME id is the mistake the check names: every row
# reads as sealed by the active key and none of them open.
# NOCTORNAL_TOTP_KEK_ID=env:v2
# NOCTORNAL_TOTP_KEK_RETIRED=env:v1=<the previous base64 key>

# Peppers the hash of every issued ingest key. Rotating it invalidates
# every key that has already been handed to a partner.
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
NOCTORNAL_INGEST_PEPPER=replace-me-ingest-pepper


# ---------------------------------------------------------------------------
# Hostnames, origins and the proxy
# ---------------------------------------------------------------------------

# NOCTORNAL_HOSTNAME, NOCTORNAL_SAMPLE_HOSTNAME and NOCTORNAL_TLS_MODE, the
# two names Caddy terminates TLS for and how, are NOT here any more: they are
# in infra/production/caddy.env (copy caddy.env.example), which only the caddy
# service reads. This file reaches every other service, and Caddy, the one
# process the internet reaches before any sign-in, must not hold it
# (infra-5, 2026-10-03). Lines left over from an older copy of this file are
# harmless and nothing reads them.

# The application origin: scheme and host, no trailing slash. Every link in
# every e-mail is built from this, so a wrong value produces mail that
# arrives and cannot be clicked.
NOCTORNAL_BASE_URL=https://noctornal.example.org

# The origin THIS process is served at. It is the application origin here;
# the sample-origin service overrides it in-process with
# NOCTORNAL_SAMPLE_ORIGIN. Leaving it as the application origin is the safe
# direction: a process that does not say which origin it is gets treated as
# the application, and the application refuses to hand over sample bytes.
NOCTORNAL_PUBLIC_ORIGIN=https://noctornal.example.org

# Where sample bytes are served from. Read by BOTH processes: the
# application needs it to redirect the console and to name that origin in
# the console's CSP connect-src, and the sample process needs it to
# recognise itself. Unset, every sample download refuses and the readiness
# register reports the origin split as OFF -- which it is.
#
# It must be an origin: scheme://host[:port], with no path. `https://
# noctornal.example.org/samples` is a location on the application origin,
# not a separate one, and it is refused as such.
NOCTORNAL_SAMPLE_ORIGIN=https://samples.example.org

# Bind each session to the address it was created from. A stolen session
# cookie is then useless from anywhere else.
NOCTORNAL_SESSION_STRICT_BINDING=1

# How many reverse proxies sit in front. Caddy is one. The application
# counts entries in X-Forwarded-For FROM THE RIGHT, so 1 reads the address
# Caddy actually observed and any earlier entries the client invented are
# ignored. Set to 0 (or unset) and the client's address is whatever uvicorn
# reports as the peer: this compose file starts it with --forwarded-allow-ips
# for Caddy, which makes that the client's own, and a process started any
# other way would meter the entire internet as a single subject, record Caddy
# as the origin of every login and pin every session to one address. The
# readiness register (proxy_hops_declared) reports an unset count in
# production.
NOCTORNAL_TRUSTED_PROXY_HOPS=1

# The second person who approves turning off a case's merge requirement
# must have held case.update on that case for this many days, read from the
# assignment's grant time by the database clock (docs/05, F39). Unset is 7.
# 0 turns the rule off and nothing else does; a value that is not a whole
# number from 0 to 365 is held to 7 and refused at boot.
# NOCTORNAL_RELAX_SEASONING_DAYS=7

# Turns on the boot-time refusals. The compose file also sets this on every
# application service, and compose's `environment:` wins -- so changing it
# here does not turn them off. It is written down because it is part of the
# configuration, not because this is where it is decided.
NOCTORNAL_ENV=production


# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------

# A relay that speaks TLS. Unset, every notification delivery raises
# TransportError and the readiness register fails smtp_configured.
SMTP_HOST=smtp.example.org

# 587 with STARTTLS, or 465 with implicit TLS.
SMTP_PORT=587
SMTP_USERNAME=replace-me-smtp-username
SMTP_PASSWORD=replace-me-smtp-password

# LEAVE THIS UNSET. It exists for the development Mailpit sink. Set, a
# failed STARTTLS negotiation falls back to sending case material in the
# clear -- docs/07 is "never plaintext" -- and the readiness register fails
# on its presence alone.
# SMTP_ALLOW_PLAINTEXT=

# The From: address. Defaults to noctornal@localhost, which most relays
# refuse and most recipients' spam filters distrust.
SMTP_FROM=noctornal@example.org


# ---------------------------------------------------------------------------
# Legal declarations -- docs/16, and see infra/production/README.md
# ---------------------------------------------------------------------------
# These two are a DECLARATION the software records and cannot verify. A
# false declaration produces a working system and an unlawful deployment.
# Sample ingest is refused until both are set, which is the point: it
# cannot become a one-click accident.

# A reference an auditor can follow to the prohibited-content policy your
# counsel wrote (docs/16 L1). A URL, a document number, a shared-drive
# path. The placeholder below is not one.
NOCTORNAL_PROHIBITED_CONTENT_POLICY=replace-me-policy-reference

# The named human material is escalated to. A role name is acceptable only
# if somebody actually holds it.
NOCTORNAL_DESIGNATED_PERSON=replace-me-designated-person

# Counsel's determination that this deployment may HOLD known-material
# prohibited-content hash sets (docs/16 L1 item 5 and C3). A reference an
# auditor can follow, copied onto every list imported. Leave it unset
# unless counsel has said so: until it is set no list can be imported, and
# nothing is screened, which is the lawful default in most deployments.
# The production boot refuses the replace-me placeholder.
# NOCTORNAL_HASH_SET_AUTHORITY=


# ---------------------------------------------------------------------------
# Retention
# ---------------------------------------------------------------------------

# The retain-until every evidence PUT sets on its own object, in days.
# `EvidenceStorage.put()` always passes this explicitly as a COMPLIANCE
# retention, which overrides the bucket default -- so this is the value
# that governs. The bucket default of COMPLIANCE 365d in compose.yml is
# defence in depth for a future code path that forgets to pass one; if you
# raise this, raise that literal too. Nothing keeps them in step.
#
# COMPLIANCE cannot be lifted by anyone, including the root credential. A
# number typed here too large is not correctable later.
EVIDENCE_RETENTION_DAYS=365

# The lock above is the SHORTEST: an exhibit is locked to its case's
# retention date when that is later, at lodging and whenever the date is
# extended, but never more than this many days ahead in one step. A case
# retained past it has its exhibits' locks offered for lengthening again in
# the Evidence pane as they fall behind. The bound is what stands between a
# mistyped retention year and a lock nobody can ever lift.
EVIDENCE_LOCK_HORIZON_DAYS=3650

# The largest exhibit this deployment accepts -- and locks for that period.
# REQUIRED under NOCTORNAL_ENV=production: an accepted byte is a permanent
# commitment, so the boot check refuses a deployment that left this to the
# 256 MiB default. Bytes, or a number with K, M or G (binary): 512MiB.
# Read once at start; the readiness register says "restart" if you edit it.
NOCTORNAL_MAX_EVIDENCE_BYTES=268435456

# The largest sample the Lab accepts. Optional; the same 256 MiB default.
# The sample bucket is not locked (docs/11), so this is about memory and
# the quarantine queue rather than storage.
# NOCTORNAL_MAX_SAMPLE_BYTES=268435456

# The largest prohibited-content hash list the console imports (default
# 64 MiB). A larger list goes through scripts/sample_screen.py import on
# the server.
# NOCTORNAL_MAX_SCREENING_LIST_BYTES=67108864


# ---------------------------------------------------------------------------
# First-run setup token (README, step 5). OPTIONAL, and left unset the web
# first-run route does not exist in production: create the first account with
# scripts/bootstrap.py create-user instead.
# ---------------------------------------------------------------------------
# Set it only if you want to make the first account through the console or
# the API. The caller must present it (X-Setup-Token), because the route is on
# the public internet from the moment Caddy starts. At least 32 characters or
# the API will not start: `openssl rand -hex 32`. It opens the door only while
# no account exists; delete this line once the first account is made.
# NOCTORNAL_SETUP_TOKEN=


# ---------------------------------------------------------------------------
# Sandbox: a self-hosted CAPEv2 (docs/11, docs/07). Unset: no sandbox,
# and a detonation request is recorded and never sent.
# ---------------------------------------------------------------------------
# Only the encrypted archive is ever sent, by scripts/sandbox_dispatch.py,
# through the egress route integration:sandbox. Create that route under
# Administration, Egress, with an allowlist entry for the CAPE host and
# port. Harden CAPE first: token_auth_enabled = yes in api.conf and
# enabled = yes under [web_auth] in web.conf.
# NOCTORNAL_SANDBOX_PROVIDER=capev2
# NOCTORNAL_SANDBOX_URL=https://cape.lab.example:8000
# NOCTORNAL_SANDBOX_TOKEN=
# NOCTORNAL_SANDBOX_NAME=cape
# The target's exposure (NONE, VENDOR or PUBLIC) and ceiling (CLEAR, GREEN
# or AMBER) are YOUR declarations (docs/16 D5); neither has a default.
# NOCTORNAL_SANDBOX_EXPOSURE=
# NOCTORNAL_SANDBOX_CEILING=
# The network a CAPE on a private address sits in, as CIDR.
# NOCTORNAL_SANDBOX_NETWORK=
# CAPE network routes a request may pick: none, drop and inetsim are
# isolated; anything else is live and needs a second person's sign-off.
# NOCTORNAL_SANDBOX_NETWORK_ROUTES=none
# NOCTORNAL_SANDBOX_DEFAULT_NETWORK_ROUTE=none
# Analysis machines a request may name, each ISOLATED or LIVE.
# NOCTORNAL_SANDBOX_MACHINES=
# NOCTORNAL_SANDBOX_CA_FILE=
# NOCTORNAL_SANDBOX_TIMEOUT_S=180
# NOCTORNAL_SANDBOX_MAX_REPORT_BYTES=16777216
# NOCTORNAL_SANDBOX_MIN_INTERVAL_S=30
# NOCTORNAL_SANDBOX_GIVE_UP_AFTER_S=21600
# NOCTORNAL_SANDBOX_PASS_BUDGET_S=240
# off, or config: propose the payload-configuration values CAPE extracted.
# NOCTORNAL_SANDBOX_AUTOPROPOSE=off


# ---------------------------------------------------------------------------
# Optional -- unset unless you need them
# ---------------------------------------------------------------------------

# Comma-separated domains that may receive redirected notifications. Unset,
# notifications go only to the account e-mail an administrator controls,
# and a user's attempt to redirect them is refused. A subject line carries
# the case code, so this is an exfiltration channel: leave it unset unless
# you have decided otherwise.
# NOCTORNAL_NOTIFY_ADDRESS_DOMAINS=

# Comma-separated host suffixes belonging to your own MTAs. Used when
# parsing Received: chains on submitted e-mail. Unset means "we do not know
# which MTAs are ours", and only the first hop is trusted -- honest, and
# weaker.
# NOCTORNAL_TRUSTED_MTA_HOSTS=

# Webhook notification channel. The channel is skipped entirely when the
# URL is unset.
# In production the URL must be https, and it is reached only through
# the egress route "webhook" (Administration, Egress), which must admit its
# host and port. No redirect is followed and no HTTP(S)_PROXY is read. The
# ledger stores the address with its path withheld: a path commonly carries
# the hook's bearer secret.
# NOCTORNAL_WEBHOOK_URL=
# NOCTORNAL_WEBHOOK_SECRET=
# The signature the webhook carries. Unset or v1 is X-NocTORnal-Signature, an
# HMAC over the body with no time in it, which every existing receiver
# verifies. v2 is opt-in: X-NocTORnal-Signature-V2 carries a timestamp and an
# HMAC over timestamp.body, and a v2 delivery carries no v1 header, so move
# the receiver first (docs/07, Webhooks) and the secret must be set.
# NOCTORNAL_WEBHOOK_SIGNATURE=v1

# A cap of each channel's own on what a notification carries: the highest
# label (CLEAR, GREEN or AMBER) whose case summary an email or a webhook may
# hold. A notification about anything above it goes out redacted, and so
# does every notification on the channel while the value is not a label.
# Unset, the egress gate's rules decide alone. Administration, Integrations
# shows the value it read.
# NOCTORNAL_SMTP_CEILING=
# NOCTORNAL_WEBHOOK_CEILING=

# Jira is configured in Administration, Integrations (the destination,
# its sealed credential, what it may receive) and reaches Jira only through
# the egress route "jira", which must admit the Jira host and port. Three
# optional variables: a host-wide cap on what Jira may receive (CLEAR, GREEN
# or AMBER; the stricter of this and the destination's own ceiling wins); a
# PEM bundle for a Data Center instance behind a private certificate
# authority; and the network a Data Center instance answers from, written
# with its prefix, which the route's rule for Jira then carries.
# NOCTORNAL_JIRA_CEILING=GREEN
# NOCTORNAL_JIRA_CA_FILE=
# NOCTORNAL_JIRA_NETWORK=

# Outbound lookups. Nothing is sent to any lookup provider while this
# is off, whatever is enabled in Administration, Providers. The api and the
# cron both read it from this file, so they agree; the lookup drain prints
# the value it read on its first line. "on" also needs the egress proxy.
NOCTORNAL_OUTBOUND_LOOKUPS=off
# A PEM bundle for a lookup provider that is your own instance (NONE) behind
# a private certificate authority. Applied to NONE providers that ask for it
# only: a vendor keeps the system trust store.
# NOCTORNAL_LOOKUP_CA_FILE=

# LEAVE UNSET. Any off-value here DISABLES rate limiting: login guessing is
# then braked only by the account lockout and the analytics endpoints
# become an unmetered CPU-bound path. The readiness register fails on it.
# NOCTORNAL_RATELIMIT=

# LEAVE UNSET. Serves the OpenAPI documentation UI. It describes every
# endpoint of a system whose endpoint list is itself operational detail.
# NOCTORNAL_ENABLE_DOCS=

# Web Key Directory key lookups. Off while unset. CLEAR,
# GREEN or AMBER turns them on at that ceiling; each lookup also needs the
# integration route wkd, listing each directory by name, and a second
# person to approve it. A lookup tells the directory's operator which
# address was looked up (docs/16 C14).
# NOCTORNAL_WKD_CEILING=GREEN

# Signature checks need gpg 2.4.9 or later (2.5.14 in the 2.5 series,
# 2.2.51 in the 2.2 series). Debian 13's gnupg 2.4.7-21+deb13u1 carries the
# fixes under an older version number; setting this attests that the
# installed build matches the named upstream release. It is recorded on
# every verification row and shown in the pgp_verifier readiness row.
# NOCTORNAL_GPG_PATCHED_AS=2.4.9
