# Template for infra/production/secrets.env, which is NOT in git.
#
#   cp infra/production/secrets.env.example infra/production/secrets.env
#   chown root:root infra/production/secrets.env
#   chmod 600      infra/production/secrets.env
#
# Every value below is a PLACEHOLDER. Replace all of them. Nothing in this
# stack checks that you did, and several of them fail silently rather than
# loudly if you do not -- each line says which.
#
# Two warnings before you edit anything:
#
#   1. `docker compose config` PRINTS the contents of this file, resolved
#      into each service's environment. Do not paste that output into a
#      ticket, a chat or a bug report.
#
#   2. Passwords are embedded in URLs below. Generate them from a URL-safe
#      alphabet or percent-encode them by hand -- an unencoded `@`, `:`,
#      `/` or `#` in a DSN silently truncates the URL into a different,
#      valid-looking one:
#
#          python -c "import secrets; print(secrets.token_urlsafe(32))"
#
#      `token_urlsafe` emits only letters, digits, `-` and `_`, all of
#      which are safe unencoded.


# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
# There are TWO roles on purpose. `noctornal` owns the schema and is the
# only thing that runs Alembic. `noctornal_app` is least privilege, is not
# the owner, and cannot ALTER TABLE ... DISABLE TRIGGER -- which is exactly
# what a compromised API process would want in order to write around the
# audit and custody chains.

# The OWNER role's password, given to the Postgres image at initdb.
# It must be BYTE-IDENTICAL to the password inside
# NOCTORNAL_MIGRATION_DATABASE_URL below. Nothing compares them; a mismatch
# shows up as the migration job failing to authenticate, on first boot.
POSTGRES_PASSWORD=replace-me-owner-password

# The APP role's password. Read by the initdb script that creates the role.
# initdb scripts run ONCE, against an empty data directory: changing this
# later does nothing to an existing cluster, and you have to ALTER ROLE by
# hand. It must match the password inside DATABASE_URL below.
NOCTORNAL_APP_DB_PASSWORD=replace-me-app-password

# What Alembic connects as. Read ONLY by the `migrate` service, which
# exports it over DATABASE_URL for the length of `alembic upgrade head`.
# Host `postgres` is the compose service name.
NOCTORNAL_MIGRATION_DATABASE_URL=postgresql+psycopg://noctornal:replace-me-owner-password@postgres:5432/noctornal

# What the API, the sample origin and the cron loop connect as. If this
# names the owner role the deployment works and the whole point of the
# split is gone, silently -- there is no error for "too much privilege".
DATABASE_URL=postgresql+psycopg://noctornal_app:replace-me-app-password@postgres:5432/noctornal


# ---------------------------------------------------------------------------
# Redis -- the rate limiter's meter store
# ---------------------------------------------------------------------------

# What `redis-server --requirepass` is started with. The clients read
# REDIS_URL instead, which spells the same password out again -- two
# declarations of one secret, and a mismatch reads as "Redis did not answer
# PING" in the readiness register rather than as an authentication failure.
REDIS_PASSWORD=replace-me-redis-password

# Note the empty username before the colon -- `redis://:PASSWORD@host`.
# Unset, the limiter falls back to per-process meters and four uvicorn
# workers then enforce four times the configured rate. The readiness
# register fails on an unset REDIS_URL for that reason.
REDIS_URL=redis://:replace-me-redis-password@redis:6379/0


# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------

# MinIO's root credentials. The API uses these for the evidence and raw
# buckets. MINIO_ROOT_USER must be at least 3 characters and
# MINIO_ROOT_PASSWORD at least 8, or MinIO refuses to start.
MINIO_ROOT_USER=replace-me-minio-root-user
MINIO_ROOT_PASSWORD=replace-me-minio-root-password

# host:port with NO scheme -- the minio client library builds the URL from
# MINIO_SECURE. Putting `http://` here produces a connection error that
# names DNS rather than the setting.
#
# The host part must be `minio`, because that is the name in the
# certificate's subjectAltName (infra/production/README.md, step 3) and the
# name every client verifies the handshake against.
MINIO_ENDPOINT=minio:9000

# The API's own credentials for evidence and raw captures. Same values as
# the root pair above: MinIO is reached only over the compose network and
# no port is published. Splitting these into a second service account is
# worthwhile and has not been done.
MINIO_ACCESS_KEY=replace-me-minio-root-user
MINIO_SECRET_KEY=replace-me-minio-root-password

# NOT optional, and not a formality. `config.enforce_environment()` refuses
# to start the API unless this is exactly "true" (no leading space -- the
# refusal deliberately matches the clients' own strict test). MinIO is given
# a certificate for that reason; see step 3 of the README. Set to false and
# the API will not boot; set to true with no certificate in ./tls and every
# evidence call fails its handshake.
MINIO_SECURE=true

# The WORM bucket. Created --with-lock by the minio-init service, and
# object lock CANNOT be enabled afterwards. Renaming this variable after
# first boot points the API at a bucket that has no lock, and the readiness
# register is what catches that.
EVIDENCE_BUCKET=noctornal-evidence

# Raw captures. No lock, no retention rule.
INGEST_BUCKET=noctornal-raw

# ---- The sample store, on its own credentials -----------------------------
# SAMPLE_* override MINIO_* for the samples bucket alone (samples.py falls
# back to the MINIO_* pair when these are unset). SAMPLE_ACCESS_KEY and
# SAMPLE_SECRET_KEY are NOT credentials you fetch from MinIO: they are the
# credentials the minio-init service MINTS, as a service account whose
# inline policy reaches the samples bucket and nothing else. Choose them
# here and they will exist after the first `up`.

# The same MinIO, and deliberately so: one object store serving two buckets
# is a legitimate production shape, so config.py has no rule about the host
# at all. Its two rules are about the credentials, and they are rules about
# them being SET: an unset SAMPLE_ACCESS_KEY or SAMPLE_SECRET_KEY is
# refused, because SampleStorage falls back per variable to the MINIO_*
# twin and opens the malware bucket with the evidence bucket's credential
# without saying so. Nothing compares the two pairs, though, so typing the
# evidence credentials in here passes the check and produces exactly the
# shared blast radius it was written to prevent. Choose different ones.
SAMPLE_ENDPOINT=minio:9000

SAMPLE_ACCESS_KEY=replace-me-sample-access-key
SAMPLE_SECRET_KEY=replace-me-sample-secret-key

# Same rule as MINIO_SECURE above, and the API refuses to boot on this one
# separately: live malware bytes in clear text is the case docs/11 makes.
SAMPLE_SECURE=true

# NEVER give this bucket object lock or a retention default. docs/11's
# rejection path has to be able to destroy sample bytes, and a lock would
# make that impossible for the whole retention period.
SAMPLE_BUCKET=noctornal-samples


# ---------------------------------------------------------------------------
# Application secrets
# ---------------------------------------------------------------------------

# Base64, decoding to EXACTLY 32 bytes -- AES-256-GCM. It seals every TOTP
# secret at rest. Generate it with the method release/install.sh uses:
#
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
#
# LOSING THIS MEANS EVERY USER MUST RE-ENROL THEIR AUTHENTICATOR. Rotating
# it has the same effect. Back it up somewhere the compose host is not.
#
# There is no default anywhere in the code. Under NOCTORNAL_ENV=production
# -- which the compose file sets on every application service --
# `config.verify_environment()` runs the envelope's OWN reader at boot, so
# an unset or wrong-length key stops the API here, named, with the other
# refusals. Without that variable it is not caught until a second factor is
# sealed or opened: a different program, long after it was typed. The
# placeholder below is that case, so a first `up` refuses on this line
# until you replace it.
NOCTORNAL_TOTP_KEK=replace-me-base64-32-bytes

# Peppers the hash of every issued ingest key. Rotating it invalidates
# every key that has already been handed to a partner.
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
NOCTORNAL_INGEST_PEPPER=replace-me-ingest-pepper


# ---------------------------------------------------------------------------
# Hostnames, origins and the proxy
# ---------------------------------------------------------------------------

# The two names Caddy terminates TLS for. They must be genuinely different
# hosts. The runtime cannot tell a real origin split from a CNAME onto the
# same host (docs/16 C9), so nothing here will catch it if they are not.
NOCTORNAL_HOSTNAME=noctornal.example.org
NOCTORNAL_SAMPLE_HOSTNAME=samples.example.org

# `internal` for a local verification run with Caddy's own CA, or an
# e-mail address to switch Caddy to ACME with that account. See
# infra/production/Caddyfile.
NOCTORNAL_TLS_MODE=internal

# The application origin: scheme and host, no trailing slash. Every link in
# every e-mail is built from this, so a wrong value produces mail that
# arrives and cannot be clicked.
NOCTORNAL_BASE_URL=https://noctornal.example.org

# The origin THIS process is served at. It is the application origin here;
# the sample-origin service overrides it in-process with
# NOCTORNAL_SAMPLE_ORIGIN. Leaving it as the application origin is the safe
# direction: a process that does not say which origin it is gets treated as
# the application, and the application refuses to hand over sample bytes.
NOCTORNAL_PUBLIC_ORIGIN=https://noctornal.example.org

# Where sample bytes are served from. Read by BOTH processes: the
# application needs it to redirect the console and to name that origin in
# the console's CSP connect-src, and the sample process needs it to
# recognise itself. Unset, every sample download refuses and the readiness
# register reports the origin split as OFF -- which it is.
#
# It must be an origin: scheme://host[:port], with no path. `https://
# noctornal.example.org/samples` is a location on the application origin,
# not a separate one, and it is refused as such.
NOCTORNAL_SAMPLE_ORIGIN=https://samples.example.org

# Bind each session to the address it was created from. A stolen session
# cookie is then useless from anywhere else.
NOCTORNAL_SESSION_STRICT_BINDING=1

# How many reverse proxies sit in front. Caddy is one. The application
# counts entries in X-Forwarded-For FROM THE RIGHT, so 1 reads the address
# Caddy actually observed and any earlier entries the client invented are
# ignored. Set to 0 (or unset) behind this compose file and the rate
# limiter meters the entire internet as a single subject, the sign-in audit
# records Caddy as the origin of every login, and strict session binding
# pins every session to one address.
NOCTORNAL_TRUSTED_PROXY_HOPS=1

# Turns on the boot-time refusals. The compose file also sets this on every
# application service, and compose's `environment:` wins -- so changing it
# here does not turn them off. It is written down because it is part of the
# configuration, not because this is where it is decided.
NOCTORNAL_ENV=production


# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------

# A relay that speaks TLS. Unset, every notification delivery raises
# TransportError and the readiness register fails smtp_configured.
SMTP_HOST=smtp.example.org

# 587 with STARTTLS, or 465 with implicit TLS.
SMTP_PORT=587
SMTP_USERNAME=replace-me-smtp-username
SMTP_PASSWORD=replace-me-smtp-password

# LEAVE THIS UNSET. It exists for the development Mailpit sink. Set, a
# failed STARTTLS negotiation falls back to sending case material in the
# clear -- docs/07 is "never plaintext" -- and the readiness register fails
# on its presence alone.
# SMTP_ALLOW_PLAINTEXT=

# The From: address. Defaults to noctornal@localhost, which most relays
# refuse and most recipients' spam filters distrust.
SMTP_FROM=noctornal@example.org


# ---------------------------------------------------------------------------
# Legal declarations -- docs/16, and see infra/production/README.md
# ---------------------------------------------------------------------------
# These two are a DECLARATION the software records and cannot verify. A
# false declaration produces a working system and an unlawful deployment.
# Sample ingest is refused until both are set, which is the point: it
# cannot become a one-click accident.

# A reference an auditor can follow to the prohibited-content policy your
# counsel wrote (docs/16 L1). A URL, a document number, a shared-drive
# path. The placeholder below is not one.
NOCTORNAL_PROHIBITED_CONTENT_POLICY=replace-me-policy-reference

# The named human material is escalated to. A role name is acceptable only
# if somebody actually holds it.
NOCTORNAL_DESIGNATED_PERSON=replace-me-designated-person


# ---------------------------------------------------------------------------
# Retention
# ---------------------------------------------------------------------------

# The retain-until every evidence PUT sets on its own object, in days.
# `EvidenceStorage.put()` always passes this explicitly as a COMPLIANCE
# retention, which overrides the bucket default -- so this is the value
# that governs. The bucket default of COMPLIANCE 365d in compose.yml is
# defence in depth for a future code path that forgets to pass one; if you
# raise this, raise that literal too. Nothing keeps them in step.
#
# COMPLIANCE cannot be lifted by anyone, including the root credential. A
# number typed here too large is not correctable later.
EVIDENCE_RETENTION_DAYS=365


# ---------------------------------------------------------------------------
# Optional -- unset unless you need them
# ---------------------------------------------------------------------------

# Comma-separated domains that may receive redirected notifications. Unset,
# notifications go only to the account e-mail an administrator controls,
# and a user's attempt to redirect them is refused. A subject line carries
# the case code, so this is an exfiltration channel: leave it unset unless
# you have decided otherwise.
# NOCTORNAL_NOTIFY_ADDRESS_DOMAINS=

# Comma-separated host suffixes belonging to your own MTAs. Used when
# parsing Received: chains on submitted e-mail. Unset means "we do not know
# which MTAs are ours", and only the first hop is trusted -- honest, and
# weaker.
# NOCTORNAL_TRUSTED_MTA_HOSTS=

# Webhook notification channel. The channel is skipped entirely when the
# URL is unset.
# NOCTORNAL_WEBHOOK_URL=
# NOCTORNAL_WEBHOOK_SECRET=

# LEAVE UNSET. Any off-value here DISABLES rate limiting: login guessing is
# then braked only by the account lockout and the analytics endpoints
# become an unmetered CPU-bound path. The readiness register fails on it.
# NOCTORNAL_RATELIMIT=

# LEAVE UNSET. Serves the OpenAPI documentation UI. It describes every
# endpoint of a system whose endpoint list is itself operational detail.
# NOCTORNAL_ENABLE_DOCS=
