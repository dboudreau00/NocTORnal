# Caddy for the production deployment. Two site blocks, because invariant 10 is two hostnames: the
# application, and the origin sample bytes are served from.
#
# The {$VAR} placeholders (the two hostnames and NOCTORNAL_TLS_MODE) resolve at load from
# infra/production/caddy.env, which holds those three and nothing else: this is the one process
# the internet reaches before any sign-in.
#
# NOCTORNAL_TLS_MODE is one token. `internal` (the default) uses Caddy's own CA, untrusted, for a
# local run against /etc/hosts names, so a forgotten variable never hammers Let's Encrypt. An
# e-mail address selects ACME with that account address; both hostnames must then resolve to this
# host and reach port 80. Certificates and the ACME key live in the caddy-data volume, and
# re-issuing is rate-limited per hostname per week.
#
# Caddy appends the address it saw to X-Forwarded-For, so the application must run with
# NOCTORNAL_TRUSTED_PROXY_HOPS=1 to read that last entry; entries a client invents go unread.
# At 0 or unset, the client is uvicorn's peer, which compose.yml's --forwarded-allow-ips makes the
# client's own; started any other way, every request appears to come from Caddy, and the rate
# limiter, the sign-in audit and session IP binding all see one address. Readiness reports the
# unset count in production (proxy_hops_declared).
#
# `request_body max_size` stands on the five multipart file routes only, because the application
# spools such a body to a temporary file before it knows who sent it (docs/17, "a junk credential
# is still read"). The application's caps stay the authority; this is the ceiling in front and
# the api service's /tmp the bound behind. 256MiB is the default of NOCTORNAL_MAX_EVIDENCE_BYTES
# and NOCTORNAL_MAX_SAMPLE_BYTES and counts the whole body; raise it with either, and /tmp
# (infra/production/README.md, Upload sizes). Write MiB: Caddy reads 256MB as 256,000,000 bytes.
# An oversize body gets the application's problem+json; test_proxy_upload_limits.py fails on any
# file route not covered.
#
# Only the console (/ui) is compressed: an API answer carries what the caller sent, which is what
# a compression side channel (BREACH) needs. `header -Server` drops uvicorn's and Caddy's own
# Server header on both hostnames, under `handle_errors` too.

# ## Transport
#
# The application leaves Strict-Transport-Security to the terminator (http/app.py), so it is sent
# here on both hostnames: a first plain-http visit could otherwise be stripped by anything on the
# path, which then proxies the login form. One year, subdomains included, no `preload`, which
# cannot be taken back and is the operator's to make. TLS 1.3 only (docs/05). HTTP/3 is off:
# 443/udp is not published (compose.yml), so Alt-Svc must not advertise it.
# apps/api/tests/test_g48_image_context.py holds the header and the two settings below to this file.
#
# ## The log
#
# Caddy writes no access log, but logs a request with its headers on an upstream failure, and
# redacts only Cookie and Authorization by itself. The filter also takes X-Csrf-Token and
# X-Setup-Token (the first-run door's secret) out of every log line this process writes.
{
	servers {
		protocols h1 h2
	}
	log {
		format filter {
			wrap json
			fields {
				request>headers>X-Csrf-Token delete
				request>headers>X-Setup-Token delete
			}
		}
	}
}

{$NOCTORNAL_HOSTNAME} {
	tls {$NOCTORNAL_TLS_MODE:internal} {
		protocols tls1.3
	}
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header -Server

	# Only the console is compressed (see Compression above).
	@console path /ui /ui/*
	encode @console zstd gzip

	# The five routes that take a multipart file (see Upload sizes above).
	# `[^/]+` is the application's own reading of {case_id} and {ruleset_id}:
	# it routes a path whose id is not a UUID to the same handler, which reads
	# the body before it finds that out.
	@uploads path_regexp ^/api/v1/(cases/[^/]+/(evidence|deception/emails)|samples(/screening/lists|/yara/rulesets/[^/]+/versions)?)/?$
	request_body @uploads {
		max_size 256MiB
	}
	handle_errors {
		header -Server
		@too_large expression {err.status_code} == 413
		handle @too_large {
			header Content-Type application/problem+json
			respond `{"type":"about:blank","title":"Payload too large","status":413,"detail":"an upload is capped by the proxy in front of the application (request_body max_size in infra/production/Caddyfile), and this one was refused at that cap"}` 413
		}
	}

	# The API, the console at /ui and the /api/v1/live WebSocket, which
	# Caddy upgrades without any extra configuration.
	reverse_proxy api:8000
}

{$NOCTORNAL_SAMPLE_HOSTNAME} {
	tls {$NOCTORNAL_TLS_MODE:internal} {
		protocols tls1.3
	}
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header -Server
	handle_errors {
		header -Server
	}

	# A separate upstream, never api:8000: `origin_split()` decides from configuration, and the
	# api process, configured as the application, would refuse every sample download.
	reverse_proxy sample-origin:8000
}
