# Template for infra/production/egress-client.env, which is NOT in git. Read
# by api and cron (S2, 2026-09-24; infra/production/README.md, Egress).
#
#   cp infra/production/egress-client.env.example infra/production/egress-client.env
#   chown root:root infra/production/egress-client.env
#   chmod 600      infra/production/egress-client.env
#
# The values come from `python scripts/egress_setup.py keygen`. With the
# egress proxy configured, the API refuses to start while one of them is
# missing or malformed, and names it.

# The same value as in egress-proxy.env: every route token is derived from it.
NOCTORNAL_EGRESS_CLIENT_KEY=replace-me

# The same value as in egress-proxy.env: exit fingerprints are made with it
# when an administrator seals an exit. Never rotated.
NOCTORNAL_EGRESS_FINGERPRINT_KEY=replace-me

# The PUBLIC half of the proxy's seal key. The API seals exits with it and
# can never open them.
NOCTORNAL_EGRESS_SEAL_PUBLIC=replace-me
