# Template for infra/production/postgres-init.env, which is NOT in git. Read
# by the postgres service ALONE (S2, 2026-09-24).
#
#   cp infra/production/postgres-init.env.example infra/production/postgres-init.env
#   chown root:root infra/production/postgres-init.env
#   chmod 600      infra/production/postgres-init.env
#
# Every password here is one the database takes at initdb, which runs ONCE,
# on an empty volume. Changing one later changes nothing in the cluster.

# The schema OWNER's password (docs/17 F52, 2026-10-02). The Postgres image
# makes `noctornal` its bootstrap superuser with it: row-level security
# does not bind that role, and it can switch off the append-only triggers
# on the audit and custody tables. So it is here and NOT in secrets.env,
# which every application service and caddy read. migrate.env repeats it
# inside NOCTORNAL_MIGRATION_DATABASE_URL; the two must agree, and
# `sudo ./release/install.sh --production-secrets` checks that they do (and
# generates both for a database volume that does not exist yet;
# release/secrets-upgrade/README.md).
POSTGRES_PASSWORD=replace-me-owner-password

# db/init/20-egress-role.sh creates the egress proxy's role noctornal_egress
# with this password at initdb. On a volume that already exists, create the
# role by hand instead: `python scripts/egress_setup.py role-sql` prints the
# statements.
#
# This is its own file, not a line in secrets.env, because every
# application service and caddy receive secrets.env and none of them may
# write the connection ledger. egress-proxy.env repeats the password inside
# NOCTORNAL_EGRESS_DATABASE_URL; the two must agree.
NOCTORNAL_EGRESS_DB_PASSWORD=replace-me

# S1 (2026-09-25): the system role noctornal_worker, created by
# db/init/10-app-role.sh with this password at initdb (BYPASSRLS needs a
# superuser, and initdb is the one moment anything here runs as one). On a
# volume that already exists, create it with
# `python scripts/runtime_roles.py ensure --production` as a superuser.
# secrets.env repeats the password inside NOCTORNAL_WORKER_DATABASE_URL;
# the two must agree. Kept out of secrets.env itself because the sample
# origin receives secrets.env and must never be able to connect as it.
NOCTORNAL_WORKER_DB_PASSWORD=replace-me
